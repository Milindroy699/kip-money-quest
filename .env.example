# Copy to .env.local and fill in (docs/accounts.md explains where each value comes from).
# Firebase web app config (Project settings → Your apps → Web app). Public by design.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in OAuth clients (Google Cloud console → Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The iOS client's reversed client ID, e.g. com.googleusercontent.apps.1234-abcd. Build-time only.
GOOGLE_IOS_URL_SCHEME=
